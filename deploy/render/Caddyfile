# Render terminates TLS and forwards to $PORT. The frontend lives on Vercel,
# which rewrites /api/* and /tiles/* here with the prefixes intact.
{
	admin off
	auto_https off
}

:{$PORT} {
	encode gzip

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy 127.0.0.1:8000
	}

	handle /tiles/* {
		uri strip_prefix /tiles
		# TiTiler writes absolute tile URLs into tilejson from the forwarded
		# scheme; Render's proxy reaches Caddy over http, and http:// tiles are
		# blocked as mixed content on the https page.
		reverse_proxy 127.0.0.1:8001 {
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		respond "DHRUVA backend. The app is served from Vercel." 200
	}
}
