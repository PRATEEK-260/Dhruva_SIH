{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://dhruva-api.onrender.com/api/:path*" },
    { "source": "/tiles/:path*", "destination": "https://dhruva-api.onrender.com/tiles/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
